# ===== LLM 配置 =====
# LLM 提供商：ollama（本地，默认） | openai（云端）
LLM_PROVIDER=ollama
# 本地 Ollama：无需任何 key
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# 官方 OpenAI（LLM_PROVIDER=openai 时使用）：
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-3.5-turbo

# ===== Embedding 配置 =====
# Ollama 本地 embedding 模型（需先 ollama pull nomic-embed-text）
# 若 LLM_PROVIDER=openai，请改为 text-embedding-3-small
EMBEDDING_MODEL=nomic-embed-text

# ===== 向量库配置 =====
# chroma | pgvector
VECTOR_STORE_TYPE=chroma
# pgvector 连接串（VECTOR_STORE_TYPE=pgvector 时使用）
PGVECTOR_CONN_STR=postgresql://user:password@localhost:5432/agent

# ===== RAG 配置 =====
RAG_TOP_K=2
RAG_CHUNK_SIZE=200
RAG_CHUNK_OVERLAP=20

# ===== Agent 配置 =====
AGENT_TEMPERATURE=0.0
AGENT_MAX_ITERATIONS=10

# ===== 断点存储配置 =====
# memory | sqlite | redis
CHECKPOINTER_TYPE=sqlite

# ===== 追踪观测（可选） =====
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls-xxx
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
